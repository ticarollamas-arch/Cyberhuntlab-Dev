{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portal": {
      "root": ".",
      "entrypoint": "server.js"
    },
    "github-app": {
      "root": "modules/github-intelligence/artifacts/github-intelligence",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && BASE_PATH=/github/ pnpm --filter @workspace/github-intelligence build",
      "entrypoint": "server.ts"
    },
    "ziptogit": {
      "root": "modules/ziptogit",
      "installCommand": "npm install",
      "buildCommand": "BASE_PATH=/ziptogit/ npm run build",
      "entrypoint": "server.ts"
    },
    "hackmind": {
      "root": "modules/hackmind",
      "installCommand": "npm install",
      "buildCommand": "BASE_PATH=/hackmind/ npm run build",
      "entrypoint": "server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": { "service": "portal" }
    },
    {
      "source": "/admin",
      "destination": { "service": "portal" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "portal" }
    },
    {
      "source": "/github",
      "destination": { "service": "github-app" }
    },
    {
      "source": "/github/(.*)",
      "destination": { "service": "github-app" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "github-app" }
    },
    {
      "source": "/ziptogit",
      "destination": { "service": "ziptogit" }
    },
    {
      "source": "/ziptogit/(.*)",
      "destination": { "service": "ziptogit" }
    },
    {
      "source": "/hackmind",
      "destination": { "service": "hackmind" }
    },
    {
      "source": "/hackmind/(.*)",
      "destination": { "service": "hackmind" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "portal" }
    }
  ]
}
